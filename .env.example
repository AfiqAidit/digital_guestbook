# Copy to .env.local and fill in. Never commit real values.

# --- Staff access (hidden 5-tap popup) ---
# Use passphrases of 10+ characters. Super admin and host must differ.
SUPER_ADMIN_PASSCODE=
HOST_PASSCODE=
# Random 32+ chars. Signs the staff cookie. Changing it logs everyone out.
ADMIN_SESSION_SECRET=

